{
  "name": "kvlog",
  "productName": "KVLOG",
  "version": "1.0.0",
  "private": true,
  "description": "KVLOG - live production and worship presentation workspace",
  "author": "Joshua Asirifi Kwame, Cyril (CACI, Konongo media head)",
  "license": "UNLICENSED",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --win --x64",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "obs-websocket-js": "^5.0.6",
    "pdfjs-dist": "4.10.38",
    "sql.js": "^1.12.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "electron-builder": "^25.1.8",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1"
  },
  "homepage": "https://github.com/YOUR-GITHUB-NAME/kvlog",
  "build": {
    "appId": "com.kvlog.app",
    "productName": "KVLOG",
    "copyright": "© 2026 Joshua Asirifi Kwame, Cyril (CACI, Konongo media head)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "KVLOG-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KVLOG",
      "uninstallDisplayName": "KVLOG",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "asirifijoshua27-del",
        "repo": "kvlog",
        "releaseType": "release"
      }
    ]
  }
}
